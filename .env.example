# .env.example -- copy this to .env and fill in real values.
# .env itself is gitignored and must never be committed.
# =======================================

# .env.example -- copy this to .env and fill in real values.
# .env itself is gitignored and must never be committed.
# =======================================

# Flask secret key for session management and CSRF protection
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# For cloud deployment, use your cloud platform's secret manager instead

# Fernet key for encryption/decryption (must be 32 url-safe base64-encoded bytes, i.e., 44 chars)
# Generate with: python generate_production_keys.py
# For cloud deployment, use your cloud platform's secret manager instead

# Flask environment (development/production)
# For cloud deployment, set FLASK_ENV=production in your cloud platform

# Port for Flask app (optional, defaults to 5000)
PORT=5000

# Quarantine and log file locations (optional, use defaults if not set)
#QUARANTINE_FOLDER=quarantine
#LOG_FILE=antivirus_web.log

# Admin credentials -- change these before running anywhere but localhost
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$12$aAtAGxUKHyf5rdDq3UXdVu4zKrEoyeJ8zrgsUl74qzlig0g3t1zK2


# Add your environment variables here

# Network Configuration
LOCAL_IP=127.0.0.1

# Logging
LOG_LEVEL=INFO

# Rate Limiting
RATE_LIMIT_HOUR=50000
RATE_LIMIT_MINUTE=5000
RATE_LIMIT_15MIN=10000
RATE_LIMIT_STORAGE_URI=memory://

# Web security hardening
# Comma-separated IPv4/IPv6 CIDRs. Leave blank to allow all addresses.
SECURITY_IP_ALLOWLIST=
SECURITY_IP_BLOCKLIST=
CORS_ORIGINS=https://isolation-bytes.com
TRUSTED_PROXY_HOPS=0
SESSION_TIMEOUT_SECONDS=3600
MAX_REQUEST_BYTES=104857600
MAX_JSON_BYTES=1048576
# Set true only when the service is reachable over HTTPS.
SESSION_COOKIE_SECURE=
SESSION_COOKIE_SAMESITE=Lax
SECURITY_HSTS=0

# Required to enable the GitHub auto-deploy webhook safely.
GITHUB_WEBHOOK_SECRET=
GITHUB_WEBHOOK_REPOSITORY=soluzka/Isolation_Bytes
GITHUB_WEBHOOK_REF=refs/heads/security-v2

# MalwareBazaar API key (get free key from https://auth.abuse.ch/)
# Required for hash signature updates via update_signatures.py

# VirusTotal API key (optional)
# Used for on-demand file hash reputation and local signature enrichment

# ThreatFox API key (optional, free at https://auth.abuse.ch/)
# Adds IOC file hashes to malware_signatures.txt

# URLhaus API key (optional, free at https://auth.abuse.ch/)
# Adds recent malicious hosts to blocklists/

# Update Settings
AUTO_UPDATE_INTERVAL=24  # hours

# Quarantine Settings
LOG_FILE=antivirus_web.log

# Real-time Protection
RTP_ENABLED=True
RTP_SCAN_INTERVAL=5  # seconds

# Malware Detection
# No scan size/count cap: every file in every monitored folder is scanned.

# Windows Defender Integration
USE_WINDOWS_DEFENDER=True
DEFENDER_SCAN_TIMEOUT=300  # seconds

# Optional safe downloader target (used by scheduled/conditional steps)
#SAFE_DOWNLOADER_URL=
#SAFE_DOWNLOADER_OUTPUT=

# Routine maintenance and temp cleanup flags (0/false to disable)
#AV_ENABLE_TEMP_CLEANUP=0
#AV_ENABLE_ROUTINE_MAINTENANCE=0

SECRET_KEY=

FERNET_KEY=

FLASK_ENV=development


HTTPBL_API_KEY=

MALWAREBAZAAR_API_KEY=

VT_API_KEY=

THREATFOX_API_KEY=

URLHAUS_API_KEY=
