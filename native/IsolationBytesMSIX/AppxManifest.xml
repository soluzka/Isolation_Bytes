<Application xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
             xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
             xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
             xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
             IgnorableNamespaces="uap uap3 rescap">
  <VisualElements
    DisplayName="Isolation Bytes"
    Description="Isolation Bytes Antivirus - Web-based security dashboard"
    BackgroundColor="#0b1321"
    Square150x150Logo="Assets\Square150x150Logo.png"
    Square44x44Logo="Assets\Square44x44Logo.png">
    <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png"
                     Square71x71Logo="Assets\Square150x150Logo.png"
                     ShortName="Isolation Bytes">
      <uap:ShowNameOnTiles>
        <uap:ShowOn Tile="square150x150Logo" />
        <uap:ShowOn Tile="wide310x150Logo" />
      </uap:ShowNameOnTiles>
    </uap:DefaultTile>
    <uap:SplashScreen Image="Assets\Square44x44Logo.png" />
  </VisualElements>
  <Extensions>
    <uap:Extension Category="windows.fileTypeAssociation">
      <uap:FileTypeAssociation Name="isolationbytes">
        <uap:SupportedFileTypes>
          <uap:FileType>.iblic</uap:FileType>
        </uap:SupportedFileTypes>
      </uap:FileTypeAssociation>
    </uap:Extension>
  </Extensions>
</Application>
